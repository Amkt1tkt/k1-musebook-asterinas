+    // K1 MUSE Book --- (logical present preserves Wayland frame callbacks)
+    fn k1_present(&mut self, prepared: Prepared) -> Result<(), SoftBufferError> {
+        let mut actual = prepared.damage;
+        if self.surface().version() < 4 && matches!(actual, Damage::Partial(_)) {
+            actual = Damage::Full;
+        }
+        let result = (|| {
+            self.display
+                .event_queue
+                .borrow_mut()
+                .dispatch_pending(&mut State)
+                .swbuf_err("Wayland dispatch failure during K1 present")?;
+            let (width, height) = self
+                .size
+                .expect("K1 present requires configured dimensions");
+            if actual != Damage::Unchanged {
+                let (front, back) = self.buffers.as_mut().expect("K1 present requires buffers");
+                std::mem::swap(front, back);
+                k1_damage::swapped_ages(&mut front.age, &mut back.age);
+                front.attach(self.surface.as_ref().unwrap());
+                if self.surface().version() < 4 {
+                    self.surface().damage(0, 0, i32::MAX, i32::MAX);
+                } else {
+                    match actual {
+                        Damage::Partial(bounds) => self.surface().damage_buffer(
+                            bounds.x as i32,
+                            bounds.y as i32,
+                            bounds.width as i32,
+                            bounds.height as i32,
+                        ),
+                        Damage::Full => {
+                            self.surface()
+                                .damage_buffer(0, 0, width.get(), height.get())
+                        }
+                        Damage::Unchanged => unreachable!(),
+                    }
+                }
+            }
+            // An unchanged frame keeps the attached buffer and all release flags.
+            // Commit pending winit frame/geometry/scale requests even without pixels.
+            self.surface().commit();
+            match self.display.event_queue.borrow_mut().flush() {
+                Ok(()) => {}
+                // The request remains queued; the owner event loop also flushes this
+                // shared connection. Never spin or block waiting for socket capacity.
+                Err(wayland_client::backend::WaylandError::Io(error))
+                    if error.kind() == std::io::ErrorKind::WouldBlock => {}
+                Err(error) => {
+                    return Err(SoftBufferError::PlatformError(
+                        Some("K1 Wayland flush failure".into()),
+                        Some(Box::new(error)),
+                    ))
+                }
+            }
+            if actual == Damage::Unchanged {
+                let (front, back) = self.buffers.as_mut().unwrap();
+                k1_damage::unchanged_ages(&mut front.age, &mut back.age);
+            }
+            Ok(())
+        })();
+        if result.is_err() {
+            // The next caller cannot trust its historical contents after a failed
+            // logical frame, even if failure happened after attach was queued.
+            if let Some((front, back)) = self.buffers.as_mut() {
+                front.age = 0;
+                back.age = 0;
+            }
+        }
+        self.k1_damage.finish(prepared, result.is_ok());
+        result
+    }
