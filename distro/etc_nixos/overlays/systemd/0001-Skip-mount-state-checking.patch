From 3590c030252b0a7bae7749e65e4d0b4d34dbb055 Mon Sep 17 00:00:00 2001
From: Chen Chengjun <chenchengjun.ccj@antgroup.com>
Date: Sat, 6 Dec 2025 04:19:38 +0000
Subject: [PATCH] Skip mount state checking

K1 MUSE Book: keep the mount-result fallback exact across the supported pins.
Asterinas exposes mountinfo text but does not deliver mount-change
notifications. Preserve the existing successful-process fallback when
libmount cannot refresh the pending mount's state through its monitor.
---
 src/core/mount.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/src/core/mount.c b/src/core/mount.c
--- a/src/core/mount.c
+++ b/src/core/mount.c
@@ -1535,6 +1535,10 @@ static void mount_sigchld_event(Unit *u, pid_t pid, int code, int status)
                 if (f == MOUNT_SUCCESS) {
-                        /* Either /bin/mount has an unexpected definition of success, or someone raced us
-                         * and we lost. */
-                        log_unit_warning(UNIT(m), "Mount process finished, but there is no mount.");
-                        f = MOUNT_FAILURE_PROTOCOL;
+                        /* K1 MUSE Book --- (mountinfo change notifications are not implemented)
+                         * Original upstream:
+                         * log_unit_warning(UNIT(m), "Mount process finished, but there is no mount.");
+                         * f = MOUNT_FAILURE_PROTOCOL;
+                         */
+                        mount_enter_mounted(m, f);
+                        break;
+                        /* K1 MUSE Book --- */
                 }
