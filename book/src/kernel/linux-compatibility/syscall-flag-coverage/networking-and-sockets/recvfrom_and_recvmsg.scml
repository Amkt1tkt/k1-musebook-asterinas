// Supported message receive flags
// K1 MUSE Book --- (nonblocking receives and close-on-exec rights installation)
// recv_flags = MSG_PEEK | MSG_TRUNC;
recv_flags = MSG_PEEK | MSG_TRUNC | MSG_DONTWAIT | MSG_CMSG_CLOEXEC;
// K1 MUSE Book ---

// Receive message from a socket
recvfrom(
    sockfd, buf, size,
    flags = <recv_flags>,
    src_addr, addrlen
);

// K1 MUSE Book --- (only UNIX rights/credentials ancillary types are delivered)
struct unix_control = {
    cmsg_level = SOL_SOCKET,
    cmsg_type = SCM_RIGHTS,
    ..
};
struct unix_control = {
    cmsg_level = SOL_SOCKET,
    cmsg_type = SCM_CREDENTIALS,
    ..
};

struct recv_msg_hdr = {
    msg_control = NULL,
    ..
};
struct recv_msg_hdr = {
    msg_control = [ <unix_control> ],
    ..
};
// K1 MUSE Book ---

// Receive message using scatter-gather buffers and ancillary data
recvmsg(
    sockfd,
    // K1 MUSE Book --- (describe the supported ancillary header output)
    // msg,
    msg = <recv_msg_hdr>,
    // K1 MUSE Book ---
    flags = <recv_flags>
);
