// K1 MUSE Book --- (per-call nonblocking sends and SIGPIPE suppression)
send_flags = MSG_DONTWAIT | MSG_NOSIGNAL;
// K1 MUSE Book ---

struct sockaddr = {
    sa_family = AF_INET | AF_UNIX | AF_NETLINK | AF_VSOCK,
    ..
};

struct msg_hdr = {
    msg_name = <sockaddr>,
    msg_control = NULL,
    ..
};

// K1 MUSE Book --- (UNIX ancillary messages; socket-family and credential limits are in README.md)
struct unix_control = {
    cmsg_level = SOL_SOCKET,
    cmsg_type = SCM_RIGHTS,
    ..
};
struct unix_control = {
    cmsg_level = SOL_SOCKET,
    cmsg_type = SCM_CREDENTIALS,
    ..
};

struct msg_hdr = {
    msg_name = <sockaddr>,
    msg_control = [ <unix_control> ],
    ..
};
// K1 MUSE Book ---

struct mmsg_hdr = {
    // K1 MUSE Book --- (strace names the embedded header msg_hdr)
    // hdr = <msg_hdr>,
    msg_hdr = <msg_hdr>,
    // K1 MUSE Book ---
    msg_len
};

// Send message on a socket
sendto(
    sockfd, buf, len,
    // K1 MUSE Book --- (apply supported per-call send flags)
    // flags = 0,
    flags = <send_flags>,
    // K1 MUSE Book ---
    dest_addr = <sockaddr>,
    addrlen
);

// Send message using scatter-gather buffers and ancillary data
sendmsg(
    sockfd,
    msg = <msg_hdr>,
    // K1 MUSE Book --- (apply supported per-call send flags)
    // flags = 0
    flags = <send_flags>
    // K1 MUSE Book ---
);


// Send multiple messages on a socket
sendmmsg(
    sockfd,
    mmsgs = [ <mmsg_hdr> ],
    mmsg_count,
    // K1 MUSE Book --- (apply supported per-call send flags)
    // flags = 0
    flags = <send_flags>
    // K1 MUSE Book ---
);
